<configuration debug="true">
    <property name="LOG_FOLDER" value="/apps/logs/demoyofi"/>
    <property name="LOG_FILE" value="${LOG_FOLDER}/demoyofi-service.log"/>
    <property name="LOG_FILE_ROLL" value="${LOG_FOLDER}/demoyofi-service_%d{yyyy_MMdd}.log"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.classic.PatternLayout">
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} X-Request-Id=%X{X-Request-Id} %highlight(%-5level) %M \(%class{0}.java\) - %msg%n%throwable%ex</pattern>
            </layout>
        </encoder>
    </appender>

    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} X-Request-Id=%X{X-Request-Id} [%t] %-5p %c{0} : %m%n
            </pattern>
        </encoder>
        <file>${LOG_FILE}</file>
        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE_ROLL}</fileNamePattern>
            <maxHistory>360</maxHistory>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="ROLLING_FILE"/>
    </root>

</configuration>
